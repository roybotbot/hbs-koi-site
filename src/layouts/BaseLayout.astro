---
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme?: 'dark' | 'paper';
}

const { title, description, theme = 'dark' } = Astro.props;
const documentTitle = title === 'Chapel Koi Pond' ? title : `${title} | Chapel Koi Pond`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{documentTitle}</title>
  </head>
  <body data-theme={theme}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteNav />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
