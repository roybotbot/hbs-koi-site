---
import PondWake from '../pond/PondWake.astro';
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__copy">
    <p class="eyebrow">Independent pond record</p>
    <h1 id="home-title">Chapel Koi Pond</h1>
    <p class="home-hero__description">An independent record of the koi living within the Class of 1959 Chapel pond.</p>
    <div class="home-hero__plaque">
      <span>Class of 1959 Chapel</span>
      <span>Built 1992</span>
    </div>
  </div>
  <PondWake />
</section>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
    min-height: calc(100svh - 5rem);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 4%), transparent 45%),
      var(--concrete-900);
  }

  .home-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 5vw, 5rem);
  }

  .home-hero__description {
    max-width: 34rem;
    margin-block: 2.5rem 0;
    color: color-mix(in srgb, var(--paper) 78%, transparent);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }

  .home-hero__plaque {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-block: auto 0;
    padding-block-start: 3rem;
    color: var(--concrete-500);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-hero__plaque span + span::before {
    content: '·';
    margin-inline-end: 1.25rem;
  }

  @media (max-width: 800px) {
    .home-hero {
      grid-template-columns: 1fr;
    }

    .home-hero__copy {
      min-height: 70svh;
    }
  }
</style>
