---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { displayValue } from '../../lib/content/displayValue';

interface Props {
  record: CollectionEntry<'fish'>;
  index: number;
  count: number;
}

const { record, index, count } = Astro.props;
const position = String(index + 1).padStart(2, '0');
const total = String(count).padStart(2, '0');
---

<section class="specimen-field" data-specimen-field aria-labelledby={`${record.id}-title`}>
  <Image
    src={record.data.image}
    alt={record.data.imageAlt}
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    loading={index === 0 ? 'eager' : 'lazy'}
  />
  <div class="specimen-field__shade" aria-hidden="true"></div>
  <div class="specimen-field__content">
    <p class="specimen-field__position">{position} / {total}</p>
    <div class="specimen-field__identity">
      <p class="eyebrow">Visible markings · {displayValue(record.data.markings)}</p>
      <h2 id={`${record.id}-title`}>{record.data.label}</h2>
    </div>
    <a href={`/fish/${record.id}`}>Open specimen record</a>
  </div>
</section>

<style>
  .specimen-field {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    border-block-start: 1px solid var(--line-dark);
    background: var(--pond-900);
    color: var(--paper);
    isolation: isolate;
  }

  .specimen-field > :global(picture),
  .specimen-field > :global(img) {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .specimen-field :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.74) contrast(1.05) brightness(0.72);
  }

  .specimen-field__shade {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(24 48 38 / 82%), rgb(24 48 38 / 16%) 65%),
      linear-gradient(0deg, rgb(18 29 25 / 78%), transparent 55%);
  }

  .specimen-field__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr auto;
    align-items: end;
    gap: 2rem;
    width: 100%;
    min-height: 100%;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .specimen-field__position {
    grid-column: 1 / -1;
    align-self: start;
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
  }

  .specimen-field__identity {
    align-self: end;
  }

  .eyebrow {
    color: color-mix(in srgb, var(--paper) 72%, transparent);
  }

  h2 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(3.5rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  a {
    padding-block: 0.65rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-underline-offset: 0.5em;
    text-transform: uppercase;
  }

  @media (max-width: 650px) {
    .specimen-field__content {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
    }

    a {
      justify-self: start;
    }
  }
</style>
