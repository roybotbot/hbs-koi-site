---
import { Image } from 'astro:assets';
import pondImage from '../../assets/chapel/chapel-pond.jpg';
---

<div class="pond-wake" data-pond-wake>
  <Image
    class="pond-wake__fallback"
    src={pondImage}
    alt=""
    aria-hidden="true"
    data-pond-source
  />
  <canvas data-pond-canvas aria-hidden="true"></canvas>
</div>

<script>
  const cleanups = new Map<HTMLElement, () => void>();
  let wakeModule: Promise<typeof import('../../lib/pond/createPondWake')> | undefined;

  async function mountPondWakes() {
    for (const root of document.querySelectorAll<HTMLElement>('[data-pond-wake]')) {
      if (cleanups.has(root)) continue;

      const canvas = root.querySelector<HTMLCanvasElement>('[data-pond-canvas]');
      const sourceImage = root.querySelector<HTMLImageElement>('[data-pond-source]');
      if (!canvas || !sourceImage) continue;

      if (!sourceImage.complete) {
        await sourceImage.decode().catch(() => undefined);
      }
      if (!sourceImage.naturalWidth) continue;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

      wakeModule ??= import('../../lib/pond/createPondWake');
      const { createPondWake } = await wakeModule;
      cleanups.set(root, createPondWake({ canvas, sourceImage }));
    }
  }

  function cleanupPondWakes() {
    for (const cleanup of cleanups.values()) cleanup();
    cleanups.clear();
  }

  void mountPondWakes();
  document.addEventListener('astro:page-load', mountPondWakes);
  document.addEventListener('astro:before-swap', cleanupPondWakes);
</script>

<style>
  .pond-wake {
    position: relative;
    min-height: clamp(24rem, 68svh, 52rem);
    overflow: hidden;
    background: var(--pond-900);
  }

  .pond-wake__fallback,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pond-wake__fallback {
    object-fit: cover;
    object-position: center;
    filter: saturate(0.72) contrast(1.08) brightness(0.72);
  }

  canvas {
    pointer-events: none;
    opacity: 0;
  }

  .pond-wake[data-enhanced='true'] .pond-wake__fallback {
    visibility: hidden;
  }

  .pond-wake[data-enhanced='true'] canvas {
    opacity: 1;
  }
</style>
