---
import { Image } from 'astro:assets';
import Timeline from '../components/history/Timeline.astro';
import chapelLight from '../assets/chapel/chapel-light.jpg';
import chapelPond from '../assets/chapel/chapel-pond.jpg';
import { historyEvents } from '../data/history';
import { imageCredits } from '../data/imageCredits';
import BaseLayout from '../layouts/BaseLayout.astro';

const hbsHistoryUrl =
  'https://www.hbs.edu/about/campus-and-culture/campus-built-on-philanthropy/class-of-1959-chapel';
const referenceArticleUrl = 'https://en.wikipedia.org/wiki/The_Class_of_1959_Chapel';
const olegProfileUrl = 'https://www.hbs.edu/news/stories/oleg-mashtaler';
const licenseUrls: Record<string, string> = {
  'CC BY 1.0': 'https://creativecommons.org/licenses/by/1.0/',
  'CC BY-SA 3.0': 'https://creativecommons.org/licenses/by-sa/3.0/',
};
---

<BaseLayout
  title="Pond history"
  description="A sourced chronology of the Class of 1959 Chapel pond and the koi who live there."
  theme="paper"
>
  <div class="history-page">
    <header class="history-hero">
      <Image
        src={chapelPond}
        alt="Water and dense plantings in the Class of 1959 Chapel pond"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="history-hero__shade" aria-hidden="true"></div>
      <div class="history-hero__copy">
        <p class="eyebrow">Water garden chronology</p>
        <h1>The pond in context</h1>
        <p>A short, sourced record of the setting around the koi pond.</p>
      </div>
    </header>

    <section class="history-chronology" aria-labelledby="chronology-title">
      <div class="history-chronology__intro">
        <p class="eyebrow">1959 — Present</p>
        <h2 id="chronology-title">Five points in time</h2>
        <p>The chapel's history establishes the setting. The koi and their care remain the focus.</p>
      </div>
      <Timeline items={historyEvents} />
    </section>

    <section class="history-setting" aria-labelledby="setting-title">
      <div class="history-setting__image">
        <Image
          src={chapelLight}
          alt="Daylight cast across the curved chapel interior"
          widths={[480, 768, 1024]}
          sizes="(max-width: 760px) 100vw, 50vw"
        />
      </div>
      <div class="history-setting__copy">
        <p class="eyebrow">The setting</p>
        <h2 id="setting-title">Water before sanctuary</h2>
        <p>Visitors pass through the enclosed water garden before entering the chapel's main sanctuary.</p>
      </div>
    </section>

    <footer class="history-references" id="sources">
      <section class="history-sources" aria-labelledby="sources-title">
        <h2 id="sources-title">Editorial sources</h2>
        <ul id="history-sources">
          <li><a href={hbsHistoryUrl}>HBS: MBA Class of 1959 Chapel <span aria-hidden="true">↗</span></a></li>
          <li><a href={referenceArticleUrl}>Wikipedia: The Class of 1959 Chapel <span aria-hidden="true">↗</span></a></li>
          <li><a href={olegProfileUrl}>HBS News: Oleg Mashtaler <span aria-hidden="true">↗</span></a></li>
        </ul>
      </section>

      <section class="image-credits" aria-labelledby="image-credits-title">
        <h2 id="image-credits-title">Image credits</h2>
        <ul>
          {imageCredits.map((credit) => (
            <li data-image-credit>
              <strong>{credit.title}</strong>
              <span>{credit.creator}</span>
              {credit.sourceUrl.startsWith('http') ? (
                <a href={credit.sourceUrl}>Source <span aria-hidden="true">↗</span></a>
              ) : (
                <span>Supplied locally</span>
              )}
              {licenseUrls[credit.license] ? (
                <a href={licenseUrls[credit.license]}>{credit.license} <span aria-hidden="true">↗</span></a>
              ) : (
                <span>{credit.license}</span>
              )}
              <span>{credit.replacementStatus}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="accessibility-note" id="accessibility" aria-labelledby="accessibility-title">
        <h2 id="accessibility-title">Accessibility</h2>
        <p>Navigation is keyboard accessible. Reduced-motion, data-saver, low-memory, and unsupported WebGL environments retain a static pond image.</p>
      </section>
    </footer>
  </div>
</BaseLayout>

<style>
  .history-hero {
    position: relative;
    display: grid;
    min-height: min(80svh, 55rem);
    overflow: hidden;
    color: var(--paper);
  }

  .history-hero :global(img),
  .history-hero__shade,
  .history-hero__copy {
    grid-area: 1 / 1;
  }

  .history-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .history-hero__shade {
    background: linear-gradient(90deg, rgb(24 48 38 / 88%), rgb(24 48 38 / 18%) 75%);
  }

  .history-hero__copy {
    z-index: 1;
    align-self: end;
    padding: clamp(4rem, 10vw, 9rem) clamp(1.25rem, 7vw, 7rem);
  }

  .history-hero__copy .eyebrow {
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }

  .history-hero__copy > p:last-child {
    max-width: 30rem;
    margin-block: 2rem 0;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.7;
  }

  .history-chronology {
    display: grid;
    grid-template-columns: minmax(15rem, 0.65fr) minmax(20rem, 1fr);
    gap: clamp(4rem, 10vw, 10rem);
    padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 8vw, 9rem);
    background: var(--paper);
    color: var(--concrete-900);
  }

  .history-chronology__intro {
    position: sticky;
    top: 3rem;
    align-self: start;
  }

  .history-chronology__intro .eyebrow {
    color: var(--concrete-700);
  }

  .history-chronology__intro h2,
  .history-setting h2 {
    margin-block-end: 1.5rem;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .history-chronology__intro > p:last-child,
  .history-setting__copy > p:last-child {
    max-width: 32rem;
    color: var(--concrete-700);
    line-height: 1.75;
  }

  .history-setting {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    min-height: 36rem;
    background: var(--concrete-900);
    color: var(--paper);
  }

  .history-setting__image {
    min-height: 28rem;
  }

  .history-setting__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .history-setting__copy {
    align-self: center;
    padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 7vw, 7rem);
  }

  .history-setting__copy .eyebrow {
    color: var(--concrete-500);
  }

  .history-setting__copy > p:last-child {
    color: color-mix(in srgb, var(--paper) 76%, transparent);
  }

  .history-references {
    border-block-start: 1px solid var(--line-paper);
    background: var(--paper);
    color: var(--concrete-700);
  }

  .history-sources,
  .image-credits,
  .accessibility-note {
    padding: 2rem clamp(1.25rem, 5vw, 5rem);
  }

  .history-sources,
  .accessibility-note {
    display: grid;
    grid-template-columns: minmax(9rem, 0.25fr) 1fr;
    gap: 1rem clamp(2rem, 6vw, 6rem);
  }

  .image-credits,
  .accessibility-note {
    border-block-start: 1px solid var(--line-paper);
  }

  .history-references h2 {
    margin: 0;
    color: var(--concrete-900);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .history-references ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .history-sources ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.5rem;
  }

  .image-credits > ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: 1.5rem;
    border-block-start: 1px solid var(--line-paper);
  }

  .image-credits li {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) repeat(4, auto);
    gap: 0.75rem;
    padding-block: 0.85rem;
    border-block-end: 1px solid var(--line-paper);
  }

  .image-credits li:nth-child(odd) {
    padding-inline-end: 1rem;
  }

  .image-credits li:nth-child(even) {
    padding-inline-start: 1rem;
    border-inline-start: 1px solid var(--line-paper);
  }

  .image-credits strong {
    color: var(--concrete-900);
    font-weight: 600;
  }

  .accessibility-note p {
    max-width: 48rem;
    margin: 0;
    line-height: 1.7;
  }

  .history-references a {
    text-underline-offset: 0.3em;
  }

  @media (max-width: 760px) {
    .history-chronology,
    .history-setting {
      grid-template-columns: 1fr;
    }

    .history-chronology__intro {
      position: static;
    }

    .history-sources,
    .accessibility-note {
      grid-template-columns: 1fr;
    }

    .image-credits > ul {
      grid-template-columns: 1fr;
    }

    .image-credits li {
      grid-template-columns: 1fr 1fr;
    }

    .image-credits li:nth-child(odd),
    .image-credits li:nth-child(even) {
      padding-inline: 0;
      border-inline-start: 0;
    }
  }
</style>

<style is:global>
  #main-content:has(.history-page) {
    padding: 0;
  }
</style>
